# Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Installed Microsoft Edge; no Chromium download needed.
BROWSER_CHANNEL=msedge
# Enable after installing the encoder: npx playwright install ffmpeg
RECORD_VIDEO=false
# Optional credentials used through {{TEST_EMAIL}} / {{TEST_PASSWORD}}.
TEST_EMAIL=
TEST_PASSWORD=

# Per-request Gemini timeout in milliseconds (maximum 300000).
GEMINI_TIMEOUT_MS=120000
